ignore: []
# cache_only: []  # allowlist; when non-empty, overrides `ignore` entirely
ignore_local: false
ignore_build_errors: false
keep_pkgs_in_project: false
default_sdk: iphonesimulator
# Run-log retention (D-06): keep the newest runs_keep run logs, then prune
# oldest until their total size is under runs_max_mb MB. Logs are never
# truncated (D-05) -- growth is bounded only by deleting whole old runs.
# runs_keep: 50
# runs_max_mb: 500
# web_poll_seconds: 5   # dashboard state-table auto-refresh interval
# remote:
#   debug:
#     git: git@github.com:your-org/cache.git
#   release:
#     s3:
#       uri: "s3://bucket/path"
#       creds: "~/.spm-cache/s3.creds.json"
